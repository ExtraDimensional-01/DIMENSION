# Copy this file to .env.local and fill in real values for local development.

# Local dev: SQLite file, relative to project root. No extra setup needed.
# Production (Vercel): a hosted Turso database instead — DATABASE_URL becomes
# a libsql://your-db-name-yourorg.turso.io URL, and DATABASE_AUTH_TOKEN (below)
# must also be set. Vercel's filesystem can't persist a local SQLite file.
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=

# Generate a strong random secret, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Root directory (outside the source tree) where uploaded audio/artwork are
# stored WHEN R2 isn't configured — local disk fallback, used automatically
# in dev until the R2_* variables below are set.
STORAGE_DIR="./storage"

# Max upload sizes, in bytes
MAX_AUDIO_SIZE_BYTES=52428800
MAX_IMAGE_SIZE_BYTES=5242880
MAX_LICENSE_FILE_SIZE_BYTES=209715200
MAX_PROJECT_FILE_SIZE_BYTES=209715200

# --- Cloudflare R2 (production file storage) ---
# All four must be set together to enable R2 — DIMENSION falls back to local
# disk (STORAGE_DIR above) otherwise. Get these from the Cloudflare
# dashboard: R2 > Manage API tokens > Create API token. Never commit real
# values — see the setup guide for exact steps.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Email of the account allowed to hit /api/admin/storage-test (an R2
# connectivity diagnostic). Leave unset to keep that endpoint disabled.
ADMIN_EMAIL=

# --- Password reset email ---
# Public base URL of the site, used to build the link in reset emails (e.g.
# https://dimension.example.com, no trailing slash). REQUIRED in production —
# it is intentionally not taken from the request, to prevent host-header
# poisoning. Defaults to http://localhost:3000 in development.
APP_URL=
# Resend (https://resend.com) credentials for sending the email. Create an API
# key in the Resend dashboard and verify a sending domain; EMAIL_FROM must be
# an address on that domain, e.g. "DIMENSION <no-reply@yourdomain.com>".
# When both are unset in development, reset links are printed to the server
# console instead of emailed. In production, they must be set.
RESEND_API_KEY=
EMAIL_FROM=
